<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Allow the Windows-targeted app project to be restored/built on Linux CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Lukas Rejci</Authors>
    <Copyright>Copyright © Lukas Rejci</Copyright>
    <VersionPrefix>0.3.0</VersionPrefix>
    <!-- Debug builds carry a -dev suffix so a locally-run test instance is unmistakable from an
         installed release (release CI overrides this with -p:Version=<tag>). AssemblyVersion stays
         numeric (VersionPrefix), so the update check still compares cleanly. -->
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
  </PropertyGroup>
</Project>
