<UserControl x:Class="GameScout.App.Views.DealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="DealCard">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Url}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <Border Grid.Column="0" Width="104" Height="58" CornerRadius="6"
                            Background="{DynamicResource Accent.Soft}" Margin="0,0,12,0">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,104,58" RadiusX="6" RadiusY="6" />
                        </Border.Clip>
                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageSource}}"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Style="{StaticResource StoreBadge}">
                                <TextBlock Text="{Binding Store, Converter={StaticResource StoreLabel}}"
                                           Foreground="{DynamicResource Badge.Foreground}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                    Background="{DynamicResource Discount}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}"
                                           Foreground="{DynamicResource Discount.Foreground}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding SalePrice}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="{Binding NormalPrice}" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       TextDecorations="Strikethrough" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#x3009;" VerticalAlignment="Center"
                               Margin="8,0,2,0" FontSize="16" Foreground="{DynamicResource Text.Muted}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Text="{Binding LastUpdatedText}" FontSize="12" Margin="8,0,0,0"
                           Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
            <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="8"
                    Background="{DynamicResource Accent.Soft}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Text.Secondary}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="Finding deals…" FontSize="13" Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Deals}" ItemTemplate="{StaticResource DealCard}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
