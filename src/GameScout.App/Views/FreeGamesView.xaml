<UserControl x:Class="GameScout.App.Views.FreeGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="FreeGameCard">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Url}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Border Grid.Column="0" Width="104" Height="58" CornerRadius="6"
                            Background="{DynamicResource Accent.Soft}" Margin="0,0,12,0">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,104,58" RadiusX="6" RadiusY="6" />
                        </Border.Clip>
                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageSource}}"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Style="{StaticResource StoreBadge}">
                                <TextBlock Text="{Binding Store, Converter={StaticResource StoreLabel}}"
                                           Foreground="{DynamicResource Badge.Foreground}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding NormalPrice}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}" FontSize="11"
                                       Visibility="{Binding NormalPrice, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Converter={StaticResource OfferTiming}}"
                                   Margin="0,3,0,0" FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#x3009;" VerticalAlignment="Center"
                               Margin="8,0,2,0" FontSize="16" Foreground="{DynamicResource Text.Muted}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Text="{Binding LastUpdatedText}" FontSize="12" Margin="8,0,0,0"
                           Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
            <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="8"
                    Background="{DynamicResource Accent.Soft}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Text.Secondary}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="Scanning…" FontSize="13" Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="FREE NOW" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"
                           Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding CurrentlyFree.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding CurrentlyFree}" ItemTemplate="{StaticResource FreeGameCard}" />

                <TextBlock Text="No games are free right now. Check back next week!"
                           FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                        <Condition Binding="{Binding CurrentlyFree.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="COMING SOON" FontSize="11" FontWeight="Bold" Margin="0,16,0,8"
                           Foreground="{DynamicResource Text.Muted}"
                           Visibility="{Binding Upcoming.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource FreeGameCard}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
