<Window x:Class="GameScout.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameScout settings" Height="430" Width="460"
        MinHeight="430" MinWidth="460"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/gamescout.ico"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Choose which storefront region GameScout uses and how much a giveaway must normally cost."
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Secondary}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Locale" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Locale, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ScoutTextBox}" />
                <TextBlock Text="Examples: en-US, cs-CZ, de-DE" Margin="2,4,0,0" FontSize="11"
                           Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Country" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="2" Style="{StaticResource ScoutTextBox}" />
                <TextBlock Text="Two-letter code, such as US, CZ, or DE" Margin="2,4,0,0" FontSize="11"
                           Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Minimum worth" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding MinimumWorthText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ScoutTextBox}" />
                <TextBlock Text="Known-price giveaways below this amount are hidden; unknown prices stay visible."
                           Margin="2,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Changes apply the next time GameScout starts."
                       Foreground="{DynamicResource Text.Secondary}" />
            <TextBlock Text="{Binding ErrorText}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Error}"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
