<Window x:Class="GameScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameScout.App.Views"
        Title="GameScout" Height="680" Width="500"
        MinHeight="460" MinWidth="420"
        Icon="Assets/gamescout.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Assets/gamescout.ico" Width="26" Height="26"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="GameScout" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Settings" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Click="OnSettingsClick" />
                <Button Content="Theme" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Command="{Binding ToggleThemeCommand}" />
                <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Padding="0,12,0,0"
                    ItemContainerStyle="{StaticResource ScoutTabItem}">
            <TabItem Header="Free now">
                <views:FreeGamesView DataContext="{Binding Free}" Margin="0,4,0,0" />
            </TabItem>
            <TabItem Header="On sale">
                <views:DealsView DataContext="{Binding Deals}" Margin="0,4,0,0" />
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button HorizontalAlignment="Right" Content="Hide" Style="{StaticResource PrimaryButton}"
                    Click="OnHideClick" />
        </Grid>
    </Grid>
</Window>
