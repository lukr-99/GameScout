<Window x:Class="GameScout.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About GameScout" Height="640" Width="500"
        MinHeight="420" MinWidth="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/gamescout.ico"
        FontFamily="Segoe UI"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
        <!-- Pill link button that sits on the accent author card. -->
        <Style x:Key="CardLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Foreground}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Accent.Foreground}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource Accent.Foreground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" x:Name="ScrollArea" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">

                <!-- Hero -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Width="84" Height="84" CornerRadius="22" HorizontalAlignment="Center"
                            Background="{DynamicResource Accent.Soft}"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                        <Image Source="Assets/gamescout.ico" Width="52" Height="52"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="GameScout" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <Border Background="{DynamicResource Accent.Soft}" CornerRadius="999"
                            Padding="10,3" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" />
                    </Border>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="380" Margin="0,14,0,0"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>

                <!-- Author card -->
                <Border Background="{DynamicResource Accent}" CornerRadius="16" Padding="22"
                        Margin="0,0,0,22" ClipToBounds="True">
                    <Grid>
                        <!-- Soft decorative circles, drawn in the foreground colour at low opacity. -->
                        <Ellipse Width="170" Height="170" Opacity="0.10" Margin="0,-70,-60,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{DynamicResource Accent.Foreground}" />
                        <Ellipse Width="90" Height="90" Opacity="0.08" Margin="0,0,40,-40"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{DynamicResource Accent.Foreground}" />
                        <StackPanel>
                            <TextBlock x:Name="AuthorHeadline" FontSize="22" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Accent.Foreground}" />
                            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,8,0,16"
                                       Foreground="{DynamicResource Accent.Foreground}" />
                            <ItemsControl x:Name="LinkList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardLinkButton}"
                                                Tag="{Binding Url}" Click="OnLinkClick"
                                                ToolTip="{Binding Url}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Handle}" Margin="8,0,0,0"
                                                           Opacity="0.85" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Credits -->
                <TextBlock Text="CREDITS AND LICENCES" Style="{StaticResource SectionTitle}" />
                <Border Background="{DynamicResource Surface.Card}" CornerRadius="12" Padding="16,6"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                    <StackPanel>
                        <ItemsControl x:Name="CreditList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10,0,10">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Role}" FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}" />
                                        <TextBlock Text="{Binding License}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,10">
                            <StackPanel>
                                <TextBlock x:Name="CopyrightText" FontWeight="SemiBold" />
                                <TextBlock x:Name="LicenseNoteText" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</Window>
