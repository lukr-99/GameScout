<Application x:Class="FreeGameScout.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FreeGameScout.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the swappable theme dictionary (see ThemeManager). -->
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Primitives.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StoreLabelConverter x:Key="StoreLabel" />
            <conv:OfferTimingConverter x:Key="OfferTiming" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
